DATABASE_URL=postgresql+asyncpg://coverage:coverage_dev@localhost:5432/coverage
CORS_ORIGINS=
# Used only when COVERAGE_LEGACY_PROXY=true; new services use endpointUrl.
COVERAGE_LEGACY_PROXY=false
TARGET_GRAPHQL_URL=
# Exact comma-separated origins; only honored together with COVERAGE_DEV_MODE=true.
COVERAGE_DEV_UPSTREAM_ORIGINS=
# Example local upstream: http://127.0.0.1:4010,http://127.0.0.1:4020

# Server-only CLI/E2E key, at least 32 ASCII characters; never expose in frontend.
COVERAGE_API_KEY=
# Browser auth is HTTPS and same-origin by default.
COVERAGE_PUBLIC_ORIGIN=https://graphql.rebyte.fun
COVERAGE_DEV_MODE=false
# For local HTTP login ONLY: explicitly set dev mode and origin to the Vite/API origin.
# COVERAGE_DEV_MODE=true
# COVERAGE_PUBLIC_ORIGIN=http://localhost:5173

# Optional GitLab E2E orchestration (server-owned configuration only).
GITLAB_ENABLED=false
GITLAB_HOST=https://gitlab.com
GITLAB_TOKEN=
# JSON object: keys are existing Coverage service UUIDs, values are numeric GitLab project IDs.
GITLAB_SERVICE_PROJECTS={}
# Public Coverage base URL reachable from runners, including any reverse-proxy prefix; no /graphql suffix.
GITLAB_COVERAGE_URL=
COVERAGE_MIN_PERCENT=80
GITLAB_POLL_SECONDS=10
GITLAB_MAX_RUN_SECONDS=3600
