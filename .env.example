DATABASE_URL=postgresql+asyncpg://coverage:coverage_dev@localhost:5432/coverage
CORS_ORIGINS=
TARGET_GRAPHQL_URL=

# Server-only CLI/E2E key, at least 32 ASCII characters; never expose in frontend.
COVERAGE_API_KEY=
# Browser auth is HTTPS and same-origin by default.
COVERAGE_PUBLIC_ORIGIN=https://graphql.rebyte.fun
COVERAGE_DEV_MODE=false
# For local HTTP login ONLY: explicitly set dev mode and origin to the Vite/API origin.
# COVERAGE_DEV_MODE=true
# COVERAGE_PUBLIC_ORIGIN=http://localhost:5173
