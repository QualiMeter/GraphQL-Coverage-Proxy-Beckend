# Use simple URL-safe names: letters, digits and underscores.
POSTGRES_DB=coverage
POSTGRES_USER=coverage
# Required. Generate a URL-safe password with: openssl rand -hex 32
# Leave the example empty; set the generated value only in deploy/.env.
# This exact value is also interpolated into the API DATABASE_URL.
POSTGRES_PASSWORD=

# Host binding stays 127.0.0.1 regardless of this port.
API_PORT=5081
# External path prefix removed by Nginx before proxying to FastAPI.
# Leave empty only when serving the app at the origin root.
API_ROOT_PATH=/coverage
# Temporary compatibility for historical services with NULL endpoint only.
# Disabled by default. New configured services never use this global target.
COVERAGE_LEGACY_PROXY=false
TARGET_GRAPHQL_URL=
# Admin key for trusted CLI/CI; browser writes use session + role/grant + CSRF.
# Generate a separate random key: openssl rand -hex 32
# Existing services are private by default. Never put this key in the frontend.
COVERAGE_API_KEY=
# Optional comma-separated origins, e.g. https://coverage.example.com
# Empty disables cross-origin access; do not use a wildcard in production.
CORS_ORIGINS=

# Required: exact immediate Nginx transport peer IP(s) as seen inside the API
# container after Docker NAT, comma-separated. Discover/verify in staging.
# Never '*' or a Docker/private CIDR; no safe generic gateway IP can be assumed.
FORWARDED_ALLOW_IPS=
COVERAGE_PUBLIC_ORIGIN=https://graphql.rebyte.fun
