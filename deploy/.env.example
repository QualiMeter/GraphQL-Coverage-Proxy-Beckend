# Use simple URL-safe names: letters, digits and underscores.
POSTGRES_DB=coverage
POSTGRES_USER=coverage
# Required. Generate a URL-safe password with: openssl rand -hex 32
# Leave the example empty; set the generated value only in deploy/.env.
# This exact value is also interpolated into the API DATABASE_URL.
POSTGRES_PASSWORD=

# Host binding stays 127.0.0.1 regardless of this port.
API_PORT=5081
# External path prefix removed by Nginx before proxying to FastAPI.
# Leave empty only when serving the app at the origin root.
API_ROOT_PATH=/coverage
# Optional; used by the GraphQL proxy and Schema Collector introspection.
TARGET_GRAPHQL_URL=
# Optional comma-separated origins, e.g. https://coverage.example.com
# Empty disables cross-origin access; do not use a wildcard in production.
CORS_ORIGINS=
